% project with  project = {<key>}  in bib.grants.bib.
%
%   type         = research | personal
%   date         = period; ongoing: {YYYY-MM/}
%   institution  = host institution
%   funder       = funding agency;  grantnumber = its reference
%   role         = my role
%   description  = what the project is about / what I worked on (free text)
%   achievements = results, one per item, separated by " and "  (printed as bullets).
%                  " and " ALWAYS starts a new item: inside an item write {and}, "\&" or
%                  rephrase ("A and B" -> "A, B").
%   outputs      = keys of papers / software / talks that came out of it
%
% @project{Key,
%   title        = {...},
%   type         = {research},
%   date         = {2024-04/},
%   institution  = {...},
%   funder       = {...},
%   grantnumber  = {...},
%   role         = {...},
%   url          = {https://...},
%   description  = {...},
%   achievements = {First result and
%                   Second result},
%   outputs      = {Key1, Key2},
%   keywords     = {ORCINHA}
% }
