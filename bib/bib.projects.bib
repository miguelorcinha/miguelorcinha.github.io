% ------------------------------------------------------------------- research projects

@project{AMS-ASI:2024,
  title        = {Progetto ASI AMS-02 Missione Scientifica Analisi Dati},
  type         = {research},
  date         = {2024-04/},
  institution  = {Istituto Nazionale di Fisica Nucleare (INFN), Sezione di Perugia},
  location     = {Perugia, Italy},
  role         = {Postdoctoral researcher},
  funder       = {Agenzia Spaziale Italiana (ASI)},
  grantnumber  = {ASI-INFN 2019-19-HH.0 and amendment No. 2021-43-HH.0},
  url          = {https://ams02.space/},
  outputs      = {Pelosi2026, Vaisanen2026, Pelosi2025, Vaisanen2025, PhysRevLett.134.051002,
                  PhysRevLett.134.051001, AMS:2024idr, pglis:2026, pglis-data:2026},
  description  = {Development of solar modulation models that accurately describe the temporal
                  variability of the cosmic-ray flux measured near Earth; the analysis framework
                  converged into the data-driven forecasting model PgLis. Study of the impact of
                  cosmic radiation near Earth and in deep space, assessing the dose rates imparted
                  onto people and instruments in space. Participation in the analysis of the AMS
                  daily proton and orbital SEP fluxes.},
  achievements = {Developed the numerical solver of the PgLis model; led its analysis framework (LxPerugia) and
                  COSPAR Outstanding Paper Award for Young Scientists 2025 for the first paper on the model and
                  Public release of the model: pglis Python package (PyPI), open data set (Zenodo) and
                  Tools for the geomagnetic cutoff along any orbit, used for GCR dose estimates (ISS, EVA, CRaTER on LRO)},
  keywords     = {ORCINHA}
}

@project{CAESAR:2023,
